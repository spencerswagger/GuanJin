<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.guanjin</groupId>
    <artifactId>guanjin-sdk-parent</artifactId>
    <version>0.7.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>guanjin-sample-boot2</artifactId>
  <name>GuanJin Sample Boot2</name>
  <description>关津 SDK 最小样例（Spring Boot 2.7.18 / javax）：声明 AuthzModel、@RequirePermission 接口、@PreAuthorize 接口。</description>

  <dependencies>
    <dependency>
      <groupId>com.guanjin</groupId>
      <artifactId>guanjin-spring-boot2</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
